# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (para emails de confirmación de Supabase, etc.)
NEXT_PUBLIC_APP_URL=https://joseproject-iota.vercel.app

# OAuth — necesarios SOLO para refresh automático de tokens de Google/Outlook.
# Deben ser los MISMOS valores que pegas en Supabase Dashboard → Auth → Providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Para Microsoft, "common" funciona para multi-tenant + cuentas personales.
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# WhatsApp Cloud API + Gemini
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
